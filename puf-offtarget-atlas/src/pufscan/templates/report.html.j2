<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ summary.input_motif }} · PUF-OffTarget Atlas report</title>
  <script>{{ plotly_js|safe }}</script>
  <style>
    :root{--navy:#0b2239;--ink:#17252d;--muted:#65767d;--paper:#f4f7f4;--line:#d8e1de;--teal:#0b7a75;--coral:#d95852;--amber:#d59628;--a:#2f8b68;--c:#3278b7;--g:#d18a24;--u:#cf5454}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--paper);font:14px/1.55 "Avenir Next",Avenir,"Segoe UI",sans-serif}a{color:inherit}.report-nav{height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 max(24px,calc((100vw - 1220px)/2));color:white;background:var(--navy)}.brand{display:flex;align-items:center;gap:12px}.brand-mark{display:grid;grid-template-columns:repeat(2,14px);gap:2px}.brand-mark i{width:14px;height:14px;display:grid;place-items:center;color:white;font:700 8px Menlo,monospace;font-style:normal}.brand-mark i:nth-child(1){background:var(--a)}.brand-mark i:nth-child(2){background:var(--c)}.brand-mark i:nth-child(3){background:var(--g)}.brand-mark i:nth-child(4){background:var(--u)}.brand strong{font:500 18px "Iowan Old Style",Charter,Georgia,serif}.report-nav>span{color:#78c9c0;font:9px Menlo,monospace;letter-spacing:.18em}.report-hero,.report-main,.report-footer{width:min(1220px,calc(100% - 40px));margin:auto}.report-hero{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;padding:62px 20px 48px}.eyebrow{margin:0 0 12px;color:var(--teal);font:700 10px Menlo,monospace;letter-spacing:.14em;text-transform:uppercase}.report-hero h1{margin:0;color:var(--navy);font:500 clamp(34px,6vw,68px)/1.05 Menlo,monospace;letter-spacing:.12em}.report-hero>div>p:last-child{color:var(--muted)}.sequence{display:flex;gap:5px;margin:18px 0}.base{width:26px;height:32px;display:grid;place-items:center;color:white;border-radius:2px;font:700 11px Menlo,monospace}.base-a{background:var(--a)}.base-c{background:var(--c)}.base-g{background:var(--g)}.base-u,.base-t{background:var(--u)}.report-stamp{min-width:220px;padding:20px;border:1px solid var(--navy);background:white}.report-stamp span,.report-stamp small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em}.report-stamp strong{display:block;margin:6px 0;color:var(--navy);font:500 22px "Iowan Old Style",Georgia,serif}.metrics{display:grid;grid-template-columns:repeat(5,1fr);background:var(--navy)}.metric{min-height:122px;display:grid;align-content:center;padding:20px 24px;color:white;border-right:1px solid rgba(255,255,255,.16)}.metric span{color:#88b7b5;font-size:9px;text-transform:uppercase;letter-spacing:.1em}.metric strong{margin:5px 0;font:500 30px "Iowan Old Style",Georgia,serif}.metric small{color:#9bafb4}.section{padding:46px 0;border-bottom:1px solid var(--line)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:22px}.section-heading span{color:var(--teal);font:700 9px Menlo,monospace;letter-spacing:.14em}.section-heading h2{margin:6px 0 0;color:var(--navy);font:500 30px "Iowan Old Style",Charter,Georgia,serif}.section-heading p{max-width:480px;margin:0;color:var(--muted);font-size:12px}.plot-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{padding:22px;background:white;border:1px solid var(--line)}.panel h3{margin:0 0 10px;color:var(--navy);font:500 20px "Iowan Old Style",Georgia,serif}.top-card{display:grid;grid-template-columns:1fr auto;gap:30px;padding:28px;color:white;background:var(--navy)}.top-card h3{margin:6px 0;font:500 34px "Iowan Old Style",Georgia,serif}.top-card p{margin:4px 0;color:#aec1c3}.risk-disc{width:105px;height:105px;display:grid;place-content:center;text-align:center;border:7px solid var(--coral);border-radius:50%;background:#102d46}.risk-disc strong{font:500 27px "Iowan Old Style",Georgia,serif}.risk-disc span{color:#9eb6b9;font-size:8px;text-transform:uppercase}.notice{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;padding:30px;color:white;background:var(--navy)}.notice h2{margin:0;font:500 27px "Iowan Old Style",Georgia,serif}.notice p{margin:0 0 8px;color:#b1c2c5}.table-wrap{overflow:auto;max-height:720px;border:1px solid var(--line);background:white}table{width:100%;border-collapse:collapse;font-size:11px}th{position:sticky;top:0;z-index:1;padding:10px 12px;color:#5b6e74;background:#edf3f1;border-bottom:1px solid var(--line);text-align:left;font:700 8px Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}td{padding:12px;border-bottom:1px solid #e7edeb;vertical-align:top}tbody tr:nth-child(even){background:#fafcfb}.mono{font:10px Menlo,monospace}.risk{display:inline-block;min-width:42px;padding:4px;text-align:center;border-radius:2px;font:700 9px Menlo,monospace}.very-high{color:#9d302b;background:#fdecea}.high{color:#93620b;background:#fff4d9}.moderate{color:#376a6c;background:#e5f2f1}.low{color:#48634f;background:#edf4ee}.missing{color:#8a969a}.report-footer{display:flex;justify-content:space-between;gap:40px;padding:35px 20px 55px;color:var(--muted);font-size:10px}.report-footer strong{color:var(--navy)}
    @media(max-width:800px){.report-hero,.plot-grid,.notice{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.report-stamp{min-width:0}.section-heading{align-items:start;flex-direction:column}.report-nav{padding-inline:15px}.report-nav>span{display:none}}
    @media print{body{background:white}.report-nav{position:static}.section{break-inside:avoid}.table-wrap{max-height:none;overflow:visible}.plotly-graph-div{max-height:260px}.report-footer{padding-bottom:0}}
  </style>
</head>
<body data-report-brand="puf-atlas">
  <nav class="report-nav"><div class="brand"><span class="brand-mark"><i>A</i><i>C</i><i>G</i><i>U</i></span><strong>PUF-OffTarget Atlas</strong></div><span>SELF-CONTAINED ANALYSIS REPORT</span></nav>
  <header class="report-hero">
    <div><p class="eyebrow">Transcriptome-wide candidate prioritization</p><h1>{{ summary.input_motif }}</h1><div class="sequence">{% for nucleotide in summary.input_motif %}<span class="base base-{{ nucleotide|lower }}">{{ nucleotide }}</span>{% endfor %}</div><p>{{ summary.species }} · {{ summary.genome_build }} · {{ metadata.annotation_provider }} {{ summary.annotation_release }}</p></div>
    <aside class="report-stamp"><span>Analysis status</span><strong>{{ metadata.status|upper }}</strong><small>{{ metadata.generated_at }}</small><small>Software {{ metadata.software_version }}</small></aside>
  </header>
  <main class="report-main">
    <section class="metrics">
      <div class="metric"><span>Candidate sites</span><strong>{{ "{:,}".format(summary.candidate_sites) }}</strong><small>transcript hits</small></div>
      <div class="metric"><span>Candidate genes</span><strong>{{ "{:,}".format(summary.candidate_genes) }}</strong><small>unique genes</small></div>
      <div class="metric"><span>Transcripts</span><strong>{{ "{:,}".format(summary.candidate_transcripts) }}</strong><small>isoforms</small></div>
      <div class="metric"><span>Unique loci</span><strong>{{ "{:,}".format(summary.unique_genomic_loci) }}</strong><small>genomic sites</small></div>
      <div class="metric"><span>Runtime</span><strong>{{ "%.1f"|format(summary.runtime_seconds) }}s</strong><small>end-to-end</small></div>
    </section>

    {% if top_candidate %}<section class="section"><div class="section-heading"><div><span>TOP-RANKED CANDIDATE</span><h2>First candidate to validate</h2></div><p>The highest heuristic score among available evidence—not a confirmed biological off-target.</p></div><div class="top-card"><div><span class="eyebrow">RANK #1</span><h3>{{ top_candidate.gene_name or top_candidate.gene_id }}</h3><p class="mono">{{ top_candidate.transcript_id }} · {{ top_candidate.matched_sequence_rna }} · {{ top_candidate.mismatch_count }} mismatch</p><p>{{ top_candidate.consequence_summary }}</p></div><div class="risk-disc"><strong>{{ "%.1f"|format(top_candidate.risk_score) }}</strong><span>priority score</span></div></div></section>{% endif %}

    <section class="section"><div class="section-heading"><div><span>01 · LANDSCAPE</span><h2>Candidate distributions</h2></div><p>Sequence distance and integrated priority provide complementary views of the screening space.</p></div><div class="plot-grid"><div class="panel"><h3>Mismatch distribution</h3>{{ mismatch_plot|safe }}</div><div class="panel"><h3>Risk score distribution</h3>{{ risk_plot|safe }}</div></div></section>
    <section class="section"><div class="section-heading"><div><span>02 · TRANSCRIPT CONTEXT</span><h2>Top-ranked transcript</h2></div><p>Motif placement relative to CDS, UTR and splice junctions.</p></div><div class="panel">{{ schematic|safe }}</div></section>
    <section class="section"><div class="section-heading"><div><span>03 · BIOLOGICAL CONTEXT</span><h2>Expression and accessibility</h2></div><p>Unavailable components remain NA and are never replaced by invented values.</p></div><div class="plot-grid"><div class="panel"><h3>Tissue expression</h3>{{ tissue_heatmap|safe }}</div><div class="panel"><h3>RNA accessibility</h3>{{ accessibility_plot|safe }}</div></div></section>

    <section class="section"><div class="section-heading"><div><span>04 · VALIDATION QUEUE</span><h2>Top 100 candidates</h2></div><p>The complete dataset remains available in the accompanying Parquet, TSV and BED artifacts.</p></div><div class="table-wrap"><table><thead><tr><th>Rank</th><th>Gene</th><th>Transcript</th><th>Matched motif</th><th>MM</th><th>Region</th><th>Expression</th><th>Accessibility</th><th>Potential consequence</th><th>Priority</th></tr></thead><tbody>{% for hit in top_hits %}<tr><td>#{{ hit.rank }}</td><td><strong>{{ hit.gene_name or hit.gene_id }}</strong></td><td class="mono">{{ hit.transcript_id }}</td><td class="mono">{{ hit.matched_sequence_rna }}</td><td>{{ hit.mismatch_count }}</td><td>{{ hit.transcript_region }}</td><td class="{{ 'missing' if hit.target_tissue_tpm is none }}">{{ "%.2f"|format(hit.target_tissue_tpm) if hit.target_tissue_tpm is not none else 'NA' }}</td><td class="{{ 'missing' if hit.accessibility_score is none }}">{{ "%.2f"|format(hit.accessibility_score) if hit.accessibility_score is not none else 'NA' }}</td><td>{{ hit.consequence_summary }}</td><td><span class="risk {{ 'very-high' if hit.risk_score >= 75 else 'high' if hit.risk_score >= 50 else 'moderate' if hit.risk_score >= 25 else 'low' }}">{{ "%.1f"|format(hit.risk_score) }}</span></td></tr>{% else %}<tr><td colspan="10">No candidate sites were found under these settings.</td></tr>{% endfor %}</tbody></table></div></section>
    <section class="section notice"><div><p class="eyebrow">EVIDENCE & LIMITATIONS</p><h2>Use this report to choose experiments—not to claim outcomes.</h2></div><div>{% for item in limitations %}<p>— {{ item }}</p>{% endfor %}</div></section>
  </main>
  <footer class="report-footer"><p><strong>PUF-OffTarget Atlas</strong><br>Open, auditable candidate prioritization.</p><p>Generated from {{ metadata.annotation_provider }} {{ metadata.annotation_release }} · {{ summary.species }} · {{ summary.genome_build }}</p></footer>
</body>
</html>
